 if(file.sha256!==TRBONB_sha_(blob.getBytes())||read.data!==Utilities.base64Encode(blob.getBytes()))throw new Error('Verifica collaudo discordante.');
 console.log(JSON.stringify({archive_private:health.private,direct_session_upload:true,hash_verified:true,authenticated_read:true}));DriveApp.getFolderById(owner.id).setTrashed(true);
