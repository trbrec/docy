msgid "Welcome to {sitename}. This site is accessible to approved users only. To be approved, you must first register."
msgstr "Benvenuto su {sitename}. L’accesso è riservato agli utenti approvati. Per richiedere l’approvazione, devi prima registrarti."

msgid "After you register, your request will be sent to the site administrator for approval. You will then receive an email with further instructions."
msgstr "Dopo la registrazione, la tua richiesta sarà inviata all’amministratore del sito per l’approvazione. Riceverai poi un’email con le istruzioni per proseguire."

msgid "An email has been sent to the site administrator. The administrator will review the information that has been submitted and either approve or deny your request."
msgstr "È stata inviata un’email all’amministratore del sito. L’amministratore esaminerà le informazioni fornite e approverà o rifiuterà la tua richiesta."

msgid "You will receive an email with instructions on what you will need to do next. Thanks for your patience."
msgstr "Riceverai un’email con le istruzioni per proseguire. Grazie per la pazienza."

msgid "Registration successful."
msgstr "Registrazione completata."

msgid "Pending Approval"
msgstr "In attesa di approvazione"

msgid "<strong>ERROR</strong>: Your account is still pending approval."
msgstr "<strong>ERRORE</strong>: il tuo account è ancora in attesa di approvazione."

msgid "<strong>ERROR</strong>: Your account has been denied access to this site."
msgstr "<strong>ERRORE</strong>: l’accesso a questo sito è stato rifiutato per il tuo account."

msgid "<strong>ERROR</strong>: User has not been approved."
msgstr "<strong>ERRORE</strong>: l’utente non è stato approvato."
